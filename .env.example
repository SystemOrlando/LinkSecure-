# Claves opcionales de reputacion externa (dejar vacias para omitir esos checks)
LINKSECURE_GOOGLE_SAFEBROWSING_KEY=
LINKSECURE_VIRUSTOTAL_KEY=

# Tiempo maximo de red en segundos
LINKSECURE_REQUEST_TIMEOUT=8

# Origenes permitidos para CORS (JSON)
LINKSECURE_ALLOWED_ORIGINS=["http://localhost:3000"]
